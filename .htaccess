<IfModule mod_rewrite.c>
    RewriteEngine On

    # Serve real files that live inside public/ (assets, uploads)
    RewriteCond %{REQUEST_URI} !^/WebPOS-Laravel/public/
    RewriteCond %{DOCUMENT_ROOT}/WebPOS-Laravel/public%{REQUEST_URI} -f
    RewriteRule ^(.*)$ public/$1 [L]

    # Everything else -> Laravel front controller in public/
    RewriteCond %{REQUEST_URI} !^/WebPOS-Laravel/public/
    RewriteRule ^(.*)$ public/index.php [L]
</IfModule>
